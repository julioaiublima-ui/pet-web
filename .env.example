# OpenAI
OPENAI_API_KEY=sk-proj-coloque_sua_chave_aqui

# LiveKit local: valores padrao de `livekit-server --dev`.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# LiveKit Agent
JARVIS_AGENT_NAME=jarvis-central

# Modelo de voz realtime.
# O prompt original pediu GPT-4o Realtime; o ID de API correspondente e gpt-4o-realtime-preview.
# Em contas/projetos novos, a OpenAI pode recomendar gpt-realtime ou gpt-realtime-2.1.
JARVIS_REALTIME_MODEL=gpt-4o-realtime-preview
JARVIS_REALTIME_VOICE=coral
JARVIS_VAD_EAGERNESS=medium
JARVIS_NOISE_REDUCTION=near_field

# Modelo usado pelo browser-use para raciocinar sobre paginas.
JARVIS_BROWSER_MODEL=gpt-4.1-mini
JARVIS_BROWSER_HEADLESS=false
JARVIS_BROWSER_MAX_STEPS=40
JARVIS_BROWSER_TIMEOUT_SECONDS=240
JARVIS_BROWSER_RECORD_VIDEO=false

# Chrome no macOS.
JARVIS_USE_SYSTEM_CHROME=true
JARVIS_CHROME_PROFILE=
JARVIS_CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
